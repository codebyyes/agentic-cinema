# Optional for local development outside Replit.
# In Replit, keep this value in Secrets instead of this file.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Defaults to gemini-3.1-pro-preview because gemini-1.5-pro is not
# currently exposed by the API account used for this starter.
GEMINI_MODEL=gemini-3.1-pro-preview